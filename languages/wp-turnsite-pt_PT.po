msgid "Accès refusé."
msgstr "Acesso negado."

msgid "Adresse e-mail"
msgstr "Endereço de email"

msgid "Afficher la clé secrète"
msgstr "Mostrar a chave secreta"

msgid "Ajoutez le domaine dans les noms d’hôte autorisés."
msgstr "Adicione o domínio aos nomes de anfitrião permitidos."

msgid "Apparence du widget"
msgstr "Aspeto do widget"

msgid ""
"Appliquée aux tailles normale et compacte. La taille flexible utilise "
"toujours toute la largeur disponible."
msgstr ""
"Aplica-se aos tamanhos normal e compacto. O tamanho flexível utiliza sempre "
"toda a largura disponível."

msgid "Aucune clé secrète enregistrée."
msgstr "Não existe nenhuma chave secreta guardada."

msgid "Auteur"
msgstr "Autor"

msgid "Automatique (selon le navigateur)"
msgstr "Automático (preferência do navegador)"

msgid ""
"Cette aptitude est attribuée automatiquement aux administrateurs lors de "
"l’activation."
msgstr ""
"Esta capacidade é atribuída automaticamente aos administradores durante a "
"ativação."

msgid "Choisissez « Managed », créez le widget et copiez les deux clés."
msgstr "Escolha “Managed”, crie o widget e copie ambas as chaves."

msgid "Clair"
msgstr "Claro"

msgid "Cloudflare a accepté la clé secrète."
msgstr "A Cloudflare aceitou a chave secreta."

msgid "Cloudflare est injoignable"
msgstr "Não foi possível contactar a Cloudflare"

msgid "Clé de site"
msgstr "Chave do site"

msgid "Clé secrète"
msgstr "Chave secreta"

msgid "Clé secrète non testée"
msgstr "Chave secreta não testada"

msgid "Clé secrète refusée par Cloudflare"
msgstr "Chave secreta recusada pela Cloudflare"

msgid "Clé secrète valide"
msgstr "Chave secreta válida"

msgid "Commentaire refusé"
msgstr "Comentário recusado"

msgid "Commentaires WordPress et avis produits"
msgstr "Comentários do WordPress e avaliações de produtos"

msgid "Compacte — 150 × 140 px"
msgstr "Compacto — 150 × 140 px"

msgid "Connexion"
msgstr "Início de sessão"

msgid "Consulter la documentation Cloudflare"
msgstr "Consultar a documentação da Cloudflare"

msgid "Destinataire du formulaire de contact"
msgstr "Destinatário do formulário de contacto"

msgid "Enregistrez une clé secrète avant de lancer le test."
msgstr "Guarde uma chave secreta antes de executar o teste."

msgid "Envoyer"
msgstr "Enviar"

msgid "Flexible — largeur du formulaire"
msgstr "Flexível — largura do formulário"

msgid "Formulaire de contact WP TurnSite"
msgstr "Formulário de contacto WP TurnSite"

msgid "Formulaires protégés"
msgstr "Formulários protegidos"

msgid "Gestion de l’accès"
msgstr "Gestão do acesso"

msgid "Impossible de récupérer la clé secrète."
msgstr "Não foi possível obter a chave secreta."

msgid "Inscription"
msgstr "Registo"

msgid "Inscriptions WordPress Multisite"
msgstr "Registos do WordPress Multisite"

msgid "La clé de site est publique. La clé secrète doit rester privée."
msgstr "A chave do site é pública. A chave secreta deve permanecer privada."

msgid ""
"La clé secrète n’est jamais affichée dans l’administration ni envoyée au "
"navigateur."
msgstr ""
"A chave secreta nunca é apresentada na administração nem enviada para o "
"navegador."

msgid ""
"La protection de l’inscription ne réactive pas les inscriptions si WordPress "
"les a désactivées."
msgstr ""
"A proteção do registo não reativa os registos se o WordPress os tiver "
"desativado."

msgid "La réponse Cloudflare est rejetée si elle concerne un autre domaine."
msgstr "A resposta da Cloudflare é rejeitada se corresponder a outro domínio."

msgid "La vérification de sécurité a échoué. Veuillez recommencer."
msgstr "A verificação de segurança falhou. Tente novamente."

msgid "Le format de la clé de site est invalide."
msgstr "O formato da chave do site é inválido."

msgid "Le format de la clé secrète est invalide."
msgstr "O formato da chave secreta é inválido."

msgid "Le message n’a pas pu être envoyé. Vérifiez les champs et réessayez."
msgstr "Não foi possível enviar a mensagem. Verifique os campos e tente novamente."

msgid "Le nom d’hôte attendu est invalide."
msgstr "O nome de anfitrião esperado é inválido."

msgid "Les tailles normale et compacte sont centrées dans le formulaire."
msgstr "Os tamanhos normal e compacto são centrados no formulário."

msgid "L’adresse de réception du formulaire de contact est invalide."
msgstr "O endereço de destino do formulário de contacto é inválido."

msgid "Masquer la clé secrète"
msgstr "Ocultar a chave secreta"

msgid "Message"
msgstr "Mensagem"

msgid "Modules complémentaires"
msgstr "Módulos adicionais"

msgid "Mot de passe perdu"
msgstr "Palavra-passe perdida"

msgid "Nom"
msgstr "Nome"

msgid "Nom d’hôte attendu"
msgstr "Nome de anfitrião esperado"

msgid "Normale — 300 × 65 px"
msgstr "Normal — 300 × 65 px"

msgid "Objet"
msgstr "Assunto"

msgid "Obtenir les clés Cloudflare"
msgstr "Obter as chaves da Cloudflare"

msgid "Ouvrez Turnstile puis choisissez « Add widget »."
msgstr "Abra o Turnstile e escolha “Add widget”."

msgid "Ouvrir Cloudflare"
msgstr "Abrir a Cloudflare"

msgid ""
"Pour déléguer la configuration de WP TurnSite avec un gestionnaire de rôles, "
"attribuez l’aptitude :"
msgstr ""
"Para delegar a configuração do WP TurnSite com um gestor de papéis, atribua "
"a capacidade:"

msgid "Protection Cloudflare Turnstile des formulaires sensibles de WordPress."
msgstr ""
"Proteção Cloudflare Turnstile para os formulários sensíveis do WordPress."

msgid "Réponse Cloudflare inattendue."
msgstr "Resposta inesperada da Cloudflare."

msgid "Réponse Cloudflare invalide."
msgstr "Resposta inválida da Cloudflare."

msgid "Saisir la clé secrète"
msgstr "Introduza a chave secreta"

msgid "Sombre"
msgstr "Escuro"

msgid "Supprimer la clé secrète enregistrée"
msgstr "Eliminar a chave secreta guardada"

msgid "Taille du widget"
msgstr "Tamanho do widget"

msgid "Tester à nouveau"
msgstr "Testar novamente"

msgid "Utilisez le shortcode [wp_turnsite_contact_form] dans une page."
msgstr "Utilize o shortcode [wp_turnsite_contact_form] numa página."

msgid "Voir le projet sur GitHub"
msgstr "Ver o projeto no GitHub"

msgid "Votre message a bien été envoyé."
msgstr "A sua mensagem foi enviada com sucesso."

msgid "WP TurnSite"
msgstr "WP TurnSite"

#, php-format
msgid ""
"WP TurnSite est actif mais incomplet. <a href=\"%s\">Configurer les clés "
"Cloudflare</a>."
msgstr ""
"O WP TurnSite está ativo mas incompleto. <a href=\"%s\">Configure as chaves "
"da Cloudflare</a>."

msgid "WooCommerce classique"
msgstr "WooCommerce clássico"

msgid "Échelle du widget"
msgstr "Escala do widget"

msgid "État de la clé secrète"
msgstr "Estado da chave secreta"

#~ msgid ""
#~ "Ajoute Cloudflare Turnstile à la connexion et à la récupération de mot de "
#~ "passe WordPress."
#~ msgstr ""
#~ "Adiciona o Cloudflare Turnstile ao início de sessão e à recuperação de "
#~ "palavra-passe do WordPress."
